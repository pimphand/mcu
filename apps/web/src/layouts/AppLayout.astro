---
import BaseLayout from './BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import LogoutButton from '@/components/LogoutButton.vue';
import NavLink from '@/components/NavLink.astro';
import { buildNav, flatNav, type NavEntry } from '@/lib/nav';
import type { SessionClaims } from '@/lib/auth/session';
import { roleLabel } from '@/lib/format';

interface Props {
    title: string;
    user?: SessionClaims;
}

const { title, user } = Astro.props;
const path = Astro.url.pathname;

// Menu dimuat middleware (`src/middleware.ts`) dari `api.v_my_menus`, jadi
// sidebar dan pengecekan tombol memakai data yang sama tanpa query ulang.
const entries: NavEntry[] = buildNav(Astro.locals.menus ?? []);
const menuError = Astro.locals.menusError ?? '';

const mobileItems = flatNav(entries);

function isActive(href: string | null): boolean {
    if (!href) return false;
    if (href === '/app') return path === '/app';
    return path === href || path.startsWith(`${href}/`);
}
---

<BaseLayout title={title} description="Ruang kerja operasional MCU Klinik Dr Dini.">
    <div class="min-h-screen bg-surface">
        <aside class="fixed inset-y-0 left-0 z-20 hidden w-[260px] flex-col border-r border-line bg-white shadow-[0_0_15px_0_rgba(34,41,47,0.05)] lg:flex">
            <a
                href="/app"
                class="flex h-[4.9rem] items-center gap-3 border-b border-line px-5"
                aria-label="Klinik Dr Dini"
            >
                <img
                    src="/logo-drdini.png"
                    alt="Logo Klinik Dr Dini"
                    width="30"
                    height="41"
                    class="h-10 w-auto"
                />
                <span class="min-w-0">
                    <span class="block truncate text-[1.05rem] font-semibold text-ink">
                        Klinik Dr Dini
                    </span>
                    <span class="block text-[0.7rem] text-muted">Medical Check Up</span>
                </span>
            </a>

            <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Navigasi utama">
                {menuError ? (
                    <p
                        class="mx-1 rounded-[0.357rem] bg-danger-soft px-3 py-2 text-[0.75rem] leading-5 text-danger"
                        role="alert"
                    >
                        {menuError}
                    </p>
                ) : entries.length === 0 ? (
                    <p class="px-3 py-2 text-[0.75rem] text-muted">
                        Belum ada menu untuk role ini.
                    </p>
                ) : (
                    entries.map((entry) =>
                        entry.kind === 'link' ? (
                            <div class="mb-1">
                                <NavLink item={entry.item} active={isActive(entry.item.href)} />
                            </div>
                        ) : (
                            <div class="mb-5">
                                <p class="mb-2 flex items-center gap-1.5 px-3 text-[0.68rem] font-semibold uppercase tracking-[0.08em] text-muted">
                                    {entry.icon && <Icon name={entry.icon} size={13} />}
                                    {entry.title}
                                </p>
                                <ul class="space-y-1">
                                    {entry.items.map((item) => (
                                        <li>
                                            <NavLink item={item} active={isActive(item.href)} />
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ),
                    )
                )}
            </nav>

            <div class="border-t border-line px-4 py-4">
                <div class="rounded-[0.5rem] bg-[#f8f8f8] px-3 py-3">
                    <p class="truncate text-[0.8125rem] font-semibold text-ink">
                        {roleLabel(user?.app_role)}
                    </p>
                    <p class="mt-0.5 truncate text-[0.7rem] text-body">
                        {user?.contract_id
                            ? `Kontrak aktif #${user.contract_id}`
                            : 'Belum ada kontrak aktif'}
                    </p>
                </div>
                <div class="mt-3">
                    <LogoutButton client:load />
                </div>
            </div>
        </aside>

        <div class="lg:pl-[260px]">
            <header class="sticky top-0 z-10 px-3 pt-3 sm:px-6 sm:pt-6">
                <div class="flex items-center justify-between gap-4 rounded-[0.5rem] border border-line bg-white px-4 py-3 shadow-[0_4px_24px_0_rgba(34,41,47,0.08)] sm:px-5">
                    <div class="flex min-w-0 items-center gap-3">
                        <a href="/app" class="lg:hidden" aria-label="Klinik Dr Dini">
                            <img
                                src="/logo-drdini.png"
                                alt=""
                                width="28"
                                height="38"
                                class="h-9 w-auto"
                            />
                        </a>
                        <div class="min-w-0">
                            <p class="truncate text-[0.9375rem] font-semibold text-ink">{title}</p>
                            <p class="truncate text-[0.7rem] text-muted">
                                {user?.contract_id
                                    ? `Kontrak #${user.contract_id}`
                                    : 'Konteks MCU belum dipilih'}
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <a
                            href="/api/health"
                            class="hidden rounded-[0.357rem] border border-line px-3 py-2 text-[0.75rem] font-medium text-body transition hover:border-brand hover:text-brand sm:inline-flex"
                        >
                            Status sistem
                        </a>
                        <div class="hidden text-right sm:block">
                            <p class="text-[0.8125rem] font-medium text-ink">
                                {roleLabel(user?.app_role)}
                            </p>
                            <p class="text-[0.7rem] text-muted">Sesi aktif</p>
                        </div>
                        <div class="lg:hidden">
                            <LogoutButton client:load />
                        </div>
                    </div>
                </div>

                <nav
                    class="mt-2 flex gap-1 overflow-x-auto rounded-[0.5rem] border border-line bg-white p-1.5 shadow-vx lg:hidden"
                    aria-label="Navigasi seluler"
                >
                    {mobileItems.map((item) => (
                        <a
                            href={item.href ?? '/app'}
                            aria-current={isActive(item.href) ? 'page' : undefined}
                            class:list={[
                                'flex shrink-0 items-center gap-2 rounded-[0.357rem] px-3 py-2 text-[0.75rem] font-medium',
                                isActive(item.href)
                                    ? 'bg-brand text-white'
                                    : 'text-body hover:bg-[#f3f2f7]',
                            ]}
                        >
                            <Icon name={item.icon} size={15} />
                            {item.label}
                        </a>
                    ))}
                </nav>
            </header>

            <main class="mx-auto w-full max-w-[1440px] px-4 pb-8 pt-6 sm:px-6">
                <slot />
            </main>

            <footer class="mx-auto w-full max-w-[1440px] px-4 pb-8 text-[0.7rem] text-muted sm:px-6">
                Base MCU · Klinik Dr Dini · Astro + Vue + PostgreSQL + PostgREST
            </footer>
        </div>
    </div>
</BaseLayout>
