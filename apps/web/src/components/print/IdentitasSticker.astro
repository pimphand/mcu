---
import QRCode from 'qrcode';
import { ageDetail } from '@/lib/format';
import type { IdentitasParticipant } from '@/lib/identitas';
import { legacyDate, legacyShortDate, printGender } from '@/lib/print-format';
import { printQrValue } from '@/lib/print';

interface Props {
    participant: IdentitasParticipant;
    /** Nomor halaman PDF legacy (`pageNumber` pada canvas DomPDF). */
    pageNumber: number;
}

const { participant, pageNumber } = Astro.props;

// Legacy stiker identitas memakai QR 150px. Isi QR mengikuti cetakan aplikasi
// ini (kontrak-kode-jenis) supaya tetap unik per kontrak.
const qr = await QRCode.toDataURL(
    printQrValue(participant.code, participant.contract_id, 'identitas'),
    { margin: 0, width: 150 },
);

/**
 * Urutan field & nilai sama dengan
 * `resources/views/pages/report/multiple/identitas.blade.php`:
 * Status tidak dicetak, "Paket MCU" memakai `plan_name`, dan tanggal register
 * memakai format `d-m-Y`.
 */
const fields = [
    { label: 'MCU ID', value: participant.code },
    { label: 'NIK', value: participant.nik },
    { label: 'Nama', value: `${participant.name} [${printGender(participant.gender)}]` },
    { label: 'Tgl Lahir', value: legacyDate(participant.birthday) },
    { label: 'Usia', value: ageDetail(participant.birthday) },
    { label: 'Department', value: participant.department_name ?? '' },
    { label: 'Paket MCU', value: participant.plan_name ?? '' },
    { label: 'Tgl Register', value: legacyShortDate(participant.register_date) },
];
---

<div class="identitas-sticker">
    <table style="width: 100%;">
        <tbody>
            <tr>
                <td style="vertical-align: top;">
                    <table class="identitas-fields">
                        <tbody>
                            {fields.map((field) => (
                                <tr>
                                    <td style="white-space: nowrap;">{field.label}</td>
                                    <td style="white-space: nowrap;">:</td>
                                    <td style="width: 100%;">{field.value}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </td>
                <td style="width: 150px; vertical-align: top;">
                    <img
                        src={qr}
                        width="150"
                        height="150"
                        alt={`QR ${participant.code}`}
                        style="display: block; margin-left: auto;"
                    />
                </td>
            </tr>
        </tbody>
    </table>

    <div class="identitas-page-number">No Form {pageNumber}</div>
</div>

<style>
    .identitas-sticker {
        display: flex;
        /* Header ±23 mm + isi ±41 mm = ±64 mm dari area cetak 76 mm
           (100 mm - margin 1,2 cm atas/bawah). 50 mm menjaga satu stiker
           tetap satu halaman. */
        min-height: 50mm;
        flex-direction: column;
        font-size: 11px;
    }

    .identitas-fields td {
        padding: 2px 3px;
        font-size: 11px;
    }

    /* `canvas->page_script` legacy: 4pt, di kanan bawah setiap halaman. */
    .identitas-page-number {
        margin-top: auto;
        text-align: right;
        font-size: 4pt;
        line-height: 1;
    }
</style>
