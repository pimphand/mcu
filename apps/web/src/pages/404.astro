---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman tidak ditemukan">
    <main class="grid min-h-screen place-items-center bg-surface px-4">
        <div class="vx-card w-full max-w-md p-8 text-center">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-brand">404</p>
            <h1 class="mt-2 text-[1.5rem] font-semibold text-ink">Halaman tidak ditemukan</h1>
            <p class="mt-2 text-[0.875rem] leading-6 text-body">
                Alamat yang Anda buka tidak tersedia atau sudah dipindahkan.
            </p>
            <a href="/" class="vx-btn-primary mt-6">
                Kembali ke halaman utama
            </a>
        </div>
    </main>
</BaseLayout>
