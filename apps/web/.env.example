[TEMPLATE]
# Web
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:4321

# PostgREST (server-side only; never expose to the browser)
# Harus sama dengan POSTGREST_PORT di infra/.env (default 3001). PostgREST ini
# boleh berjalan lokal sambil menunjuk ke database Supabase.
POSTGREST_URL=http://127.0.0.1:3001

# Auth database: role mcu_auth (select users only).
# Self-hosted:
AUTH_DATABASE_URL=postgres://mcu_auth:change-me@127.0.0.1:5432/mcu
# Supabase (connection string dari Dashboard > Project Settings > Database):
# AUTH_DATABASE_URL=postgres://mcu_auth.<project-ref>:change-me@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Service database (server-side imports/PDF; not used by the base yet)
DATABASE_URL=postgres://mcu_service:change-me@127.0.0.1:5432/mcu

# Generate with: openssl rand -base64 48
# JWT milik aplikasi ini (dipakai BFF + PostgREST), bukan JWT Supabase.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=28800

# Direktori privat tanda tangan hasil upload (path `ttd` di tabel employees).
# Default: apps/web/storage/ttd. Berkas legacy di public/ttd tetap dibaca
# sebagai fallback, tetapi upload baru tidak pernah masuk folder public.
# SIGNATURE_DIR=/srv/mcu/storage/ttd

# Wajib `require` untuk Supabase (koneksi langsung wajib TLS).
# PGSSLMODE=require

# Port server hasil build (npm start; dipakai oleh adapter Node).
# PORT=4321
# HOST=127.0.0.1
