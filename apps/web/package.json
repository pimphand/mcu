{
    "name": "@mcu/web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
        "preview": "node --env-file-if-exists=.env dist/server/entry.mjs",
        "check": "astro check && eslint . && prettier --check . && vitest run",
        "check:fix": "eslint . --fix && prettier --write .",
        "test": "vitest run",
        "security:audit": "npm audit --omit=dev"
    },
    "dependencies": {
        "@astrojs/node": "^11.1.8",
        "@astrojs/vue": "^7.1.0",
        "@fontsource/montserrat": "^5.3.0",
        "astro": "^7.4.0",
        "bcryptjs": "^3.0.3",
        "exceljs": "^4.4.0",
        "jose": "^6.2.12",
        "pg": "^8.23.1",
        "qrcode": "^1.5.4",
        "sharp": "^0.35.5",
        "vue": "^3.5.44",
        "zod": "^4.6.7"
    },
    "overrides": {
        "exceljs": {
            "uuid": "^11.1.1"
        }
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^3.2.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
