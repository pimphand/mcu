[TEMPLATE]
# Salin ke infra/.env dan ganti semua nilai change-me.
# File ini tidak boleh di-commit.

MYSQL_DATABASE=medical_check_up
MYSQL_USER=mcu
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3307

POSTGRES_DB=mcu
POSTGRES_USER=mcu
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5433

# Role internal PostgREST dan ETL. Jangan pakai password yang sama.
# PGRST_AUTH_ROLE = nama role login untuk PostgREST. Default `mcu_authenticator`
# supaya tidak bertabrakan dengan role `authenticator` milik platform terkelola
# (Supabase) yang password-nya diatur platform.
PGRST_AUTH_ROLE=mcu_authenticator
AUTHENTICATOR_PASSWORD=change-me-authenticator
MCU_AUTH_PASSWORD=change-me-auth
MCU_SERVICE_PASSWORD=change-me-service
MCU_ADMIN_PASSWORD=change-me-admin

# Seed admin awal. Saat restore legacy, akun admin dari dump akan menggantikan
# akun ini karena ETL menghapus dan mengimpor ulang tabel users; jalankan
# restore-legacy.sh dengan SEED_ADMIN=1 (default) untuk membuatnya kembali.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-me-app-admin

# Harus sama dengan JWT_SECRET di apps/web/.env. Minimal 32 karakter acak.
# Ini JWT milik aplikasi sendiri, bukan JWT Supabase.
JWT_SECRET=change-me-minimal-32-karakter-acak-jangan-dipakai

# Bind loopback untuk PostgREST; BFF Astro memakai http://127.0.0.1:3001.
POSTGREST_PORT=3001

# ---------------------------------------------------------------------------
# Supabase sebagai PostgreSQL (alternatif service `postgres` di compose)
# ---------------------------------------------------------------------------
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string.
# Wajib ?sslmode=require. Host `db.<ref>.supabase.co` hanya punya record AAAA
# (IPv6); kalau host/docker tidak punya IPv6, pakai pooler:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# DATABASE_URL=postgresql://postgres:change-me@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
